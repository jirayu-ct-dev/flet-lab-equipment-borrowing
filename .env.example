# ============================================================
# ตั้งค่าแอประบบยืม-คืนอุปกรณ์ (คัดลอกเป็น .env แล้วกรอกค่าจริง)
# ค่าใน .env จะถูกโหลดอัตโนมัติตอนรัน (ไม่ทับ env ที่ตั้งไว้แล้ว)
# ห้าม commit ไฟล์ .env ขึ้น git เด็ดขาด
# ============================================================

# --- ฐานข้อมูล (ไม่บังคับ) ---
# APP_DB_PATH=data/lab_equipment.db
# APP_SEED_DEMO=1

# ============================================================
# LINE Login (LINE Developers Console -> Provider -> LINE Login channel)
# Channel ID / Channel secret / Callback URL ดูได้ที่ channel settings
# ============================================================

# LINE_LOGIN channel ID (คือ client_id)
LINE_CLIENT_ID=

# LINE_LOGIN channel secret (คือ client_secret)
LINE_CLIENT_SECRET=

# ต้องเป็น URL สาธารณะแบบ HTTPS ที่รันแอปนี้อยู่
# และต้องลงทะเบียนในช่อง "Callback URL" ของ LINE Login channel ให้ตรงกันเป๊ะ
# ตอน dev ใช้ ngrok เช่น https://xxxx.ngrok-free.app
LINE_REDIRECT_URL=

# ============================================================
# LIFF (ใช้เปิดแอปภายใน LINE)
# สร้าง LIFF app ในช่อง "LIFF" ของ LINE Login channel
# ============================================================

# LIFF ID (liffId) ที่ได้จากหน้า LIFF settings
LINE_LIFF_ID=

# Endpoint URL ของ LIFF (ชี้ไปที่ URL ของแอปนี้)
# ลงทะเบียนในช่อง "Endpoint URL" ของ LIFF app
LINE_LIFF_URL=

# ============================================================
# Messaging API (ส่งข้อความ/แจ้งเตือนหา user ผ่าน LINE)
# สร้างแยกเป็น "Messaging API" channel (ไม่ใช้ channel เดียวกับ Login)
# ============================================================

# Long-lived channel access token จาก Messaging API channel
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN=

# Channel secret ของ Messaging API channel
LINE_MESSAGING_CHANNEL_SECRET=

# ============================================================
# LINE Rich Menu (สลับเมนูตาม role: admin / user)
# ได้ ID จากการรัน: python scripts\register_richmenus.py
# ============================================================

# Richmenu ID สำหรับ role=admin
LINE_RICHMENU_ADMIN_ID=

# Richmenu ID สำหรับ role=user
LINE_RICHMENU_USER_ID=

# ============================================================
# LINE Notification (แจ้งเตือนหา user ที่ login ด้วย LINE)
# ============================================================

# ความถี่ของการเช็ครายการใกล้ครบกำหนด (วินาที, ค่าเริ่มต้น 21600 = 6 ชม.)
# LINE_REMINDER_INTERVAL_SECONDS=21600
